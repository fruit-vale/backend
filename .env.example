# E-mail (nodemailer): envio do contrato quando uma empresa é cadastrada.
# Gmail: GMAIL_USER (endereço) + GMAIL_APP_PASSWORD (senha de app de 16 letras).
# Sem GMAIL_USER nem SMTP_HOST o envio fica desligado e o link aparece no log da API.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Outro servidor SMTP (ignorado se GMAIL_USER estiver preenchido):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FruitVale <nao-responda@fruitvale.com.br>"
# URL pública do frontend, usada no link do contrato
APP_URL="https://fruitvale.com.br"
# Quem presta o serviço (CONTRATADA), citado no contrato
CONTRATADA_NOME=
CONTRATADA_CNPJ=
