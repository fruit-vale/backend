
# Origens do front liberadas no CORS, separadas por vírgula
CORS_ORIGINS=https://fruitvale-52da0.web.app,https://fruitvale-52da0.firebaseapp.com,http://localhost:5173

# Segredo para assinar os tokens JWT (gere com: openssl rand -base64 48)
JWT_SECRET=
# opcional, padrão 8h
JWT_EXPIRES_IN=

# Broker Mosquitto (plugin Dynamic Security). O usuário precisa da role admin
# criada pelo "mosquitto_ctrl dynsec init". Sem MQTT_URL, as rotas /mqtt respondem 503.
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# Redis para cache (opcional). Sem ele, a API consulta o banco a cada requisição.
REDIS_URL=redis://localhost:6379
