%% Diagrama entidade-relacionamento do banco FruitVale (PostgreSQL / Supabase).
%% Fonte: prisma/schema.prisma. Cardinalidade: || = exatamente um, |o = zero ou um,
%% o{ = zero ou muitos. Como gerar a imagem/PDF: docs/README-diagrama.md.
erDiagram
    empresas ||--o{ propriedades : "possui"
    empresas |o--o{ usuarios : "emprega"
    empresas |o--o{ culturas : "culturas próprias (null = plataforma)"
    usuarios |o--o{ propriedades : "é responsável por"
    propriedades ||--o{ lotes : "divide-se em"
    propriedades ||--o{ sensores : "abriga"
    culturas ||--o{ lotes : "cultura atual de"
    culturas ||--o{ ciclos_cultivo : "cultivada em"
    culturas ||--o{ dados_mercado : "cotada em"
    lotes ||--o{ ciclos_cultivo : "histórico de safras"
    lotes |o--o{ sensores : "monitorado por"
    lotes ||--o{ alertas_climaticos : "recebe"
    sensores |o--o{ alertas_climaticos : "dispara"
    sensores ||--o{ sensor_medidas : "envia os dados"
    sensores ||--o{ leituras_sensores : "registra"
    leituras_sensores ||--o{ leituras_valores : "contém"
    sensor_medidas ||--o{ leituras_valores : "valor de"

    empresas {
        int id PK
        varchar razao_social
        varchar cpf_cnpj UK
        varchar telefone
        varchar email
        varchar cidade
        varchar estado
        varchar responsavel
        timestamp created_at
    }
    usuarios {
        int id PK
        int empresa_id FK "null = administrador"
        varchar nome
        varchar cpf UK
        varchar email UK
        varchar telefone
        varchar senha_hash
        varchar tipo_usuario "ADMIN | PRODUTOR | ANALISTA"
        varchar status
        timestamp created_at
    }
    propriedades {
        int id PK
        int empresa_id FK
        int produtor_responsavel_id FK
        varchar nome
        varchar municipio
        varchar estado
        decimal latitude
        decimal longitude
        decimal area_total_ha
        varchar status "ATIVA | INATIVA"
    }
    culturas {
        int id PK
        int empresa_id FK "null = da plataforma"
        varchar nome
        varchar variedade
        decimal temp_recomendada_min
        decimal temp_recomendada_max
        decimal umidade_recomendada_min
        decimal umidade_recomendada_max
        int ciclo_medio_dias
        text descricao
    }
    lotes {
        int id PK
        int propriedade_id FK
        int cultura_id FK "espelha a safra atual"
        varchar nome_identificacao
        decimal area_ha
        date data_plantio
        date previsao_colheita
        varchar situacao "EM_PREPARO | EM_CULTIVO | COLHIDO"
        jsonb geometria "retângulo GeoJSON"
    }
    ciclos_cultivo {
        int id PK
        int lote_id FK
        int cultura_id FK
        date data_plantio
        date previsao_colheita
        date data_colheita "null = em andamento (1 por lote)"
        decimal producao
        varchar unidade_producao
        text observacoes
        timestamp criado_em
    }
    sensores {
        int id PK
        varchar codigo_sensor UK "= usuário MQTT"
        varchar tipo
        int propriedade_id FK
        int lote_id FK
        decimal latitude
        decimal longitude
        date data_instalacao
        varchar status "ATIVO | INATIVO | MANUTENCAO"
    }
    sensor_medidas {
        int id PK
        int sensor_id FK "UK com chave"
        varchar chave "campo no JSON do MQTT"
        varchar nome
        varchar unidade
        varchar tipo "TEMPERATURA, UMIDADE, PH..."
    }
    leituras_sensores {
        bigint id PK
        int sensor_id FK
        timestamp data_hora
        decimal temperatura
        decimal umidade
        decimal ph
        decimal luminosidade
        decimal precipitacao
        decimal umidade_solo
    }
    leituras_valores {
        bigint leitura_id PK, FK
        int medida_id PK, FK
        decimal valor
    }
    alertas_climaticos {
        int id PK
        int lote_id FK
        int sensor_id FK
        text mensagem
        timestamp data_hora
        bool lido
    }
    dados_mercado {
        int id PK
        int cultura_id FK
        varchar mercado_destino
        decimal preco_medio
        varchar moeda
        date data_referencia
        varchar demanda_estimada
    }
    informacoes_logisticas {
        int id PK
        varchar origem
        varchar destino
        varchar modal_transporte
        int tempo_estimado_horas
        decimal custo_estimado
        varchar empresa_transportadora
        varchar situacao
    }
