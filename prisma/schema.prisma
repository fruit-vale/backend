generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model alertas_climaticos {
  id        Int       @id @default(autoincrement())
  lote_id   Int
  sensor_id Int?
  mensagem  String
  data_hora DateTime? @default(now()) @db.Timestamp(6)
  lido      Boolean?  @default(false)
  lotes     lotes     @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sensores  sensores? @relation(fields: [sensor_id], references: [id], onUpdate: NoAction)
}

model culturas {
  id                      Int             @id @default(autoincrement())
  nome                    String          @db.VarChar(50)
  variedade               String?         @db.VarChar(50)
  temp_recomendada_min    Decimal?        @db.Decimal(5, 2)
  temp_recomendada_max    Decimal?        @db.Decimal(5, 2)
  umidade_recomendada_min Decimal?        @db.Decimal(5, 2)
  umidade_recomendada_max Decimal?        @db.Decimal(5, 2)
  ciclo_medio_dias        Int?
  descricao               String?
  empresa_id              Int?
  dados_mercado           dados_mercado[]
  lotes                   lotes[]
  empresas                empresas?       @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresa_id], map: "idx_culturas_empresa")
}

model dados_mercado {
  id               Int      @id @default(autoincrement())
  cultura_id       Int
  mercado_destino  String?  @db.VarChar(100)
  preco_medio      Decimal  @db.Decimal(10, 2)
  moeda            String?  @default("BRL") @db.VarChar(10)
  data_referencia  DateTime @db.Date
  demanda_estimada String?  @db.VarChar(50)
  culturas         culturas @relation(fields: [cultura_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model empresas {
  id           Int            @id @default(autoincrement())
  razao_social String         @db.VarChar(150)
  cpf_cnpj     String         @unique @db.VarChar(20)
  telefone     String?        @db.VarChar(20)
  email        String?        @db.VarChar(100)
  cidade       String?        @db.VarChar(100)
  estado       String?        @db.VarChar(2)
  responsavel  String?        @db.VarChar(100)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  culturas     culturas[]
  propriedades propriedades[]
  usuarios     usuarios[]
}

model informacoes_logisticas {
  id                     Int      @id @default(autoincrement())
  origem                 String   @db.VarChar(100)
  destino                String   @db.VarChar(100)
  modal_transporte       String?  @db.VarChar(50)
  tempo_estimado_horas   Int?
  custo_estimado         Decimal? @db.Decimal(10, 2)
  empresa_transportadora String?  @db.VarChar(100)
  situacao               String?  @db.VarChar(50)
}

model leituras_sensores {
  id           BigInt   @id @default(autoincrement())
  sensor_id    Int
  data_hora    DateTime @default(now()) @db.Timestamp(6)
  temperatura  Decimal? @db.Decimal(5, 2)
  umidade      Decimal? @db.Decimal(5, 2)
  ph           Decimal? @db.Decimal(6, 2)
  luminosidade Decimal? @db.Decimal(8, 2)
  precipitacao Decimal? @db.Decimal(5, 2)
  umidade_solo Decimal? @db.Decimal(5, 2)
  sensores     sensores @relation(fields: [sensor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sensor_id, data_hora], map: "idx_leituras_sensor_data")
}

model lotes {
  id                 Int                  @id @default(autoincrement())
  propriedade_id     Int
  cultura_id         Int
  nome_identificacao String               @db.VarChar(50)
  area_ha            Decimal?             @db.Decimal(10, 2)
  data_plantio       DateTime?            @db.Date
  previsao_colheita  DateTime?            @db.Date
  situacao           String?              @default("EM_CULTIVO") @db.VarChar(20)
  geometria          Json?
  alertas_climaticos alertas_climaticos[]
  culturas           culturas             @relation(fields: [cultura_id], references: [id], onUpdate: NoAction)
  propriedades       propriedades         @relation(fields: [propriedade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sensores           sensores[]

  @@index([propriedade_id], map: "idx_lotes_propriedade")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model propriedades {
  id                      Int        @id @default(autoincrement())
  empresa_id              Int
  produtor_responsavel_id Int?
  nome                    String     @db.VarChar(100)
  municipio               String     @db.VarChar(100)
  estado                  String     @db.VarChar(2)
  latitude                Decimal?   @db.Decimal(10, 8)
  longitude               Decimal?   @db.Decimal(11, 8)
  area_total_ha           Decimal?   @db.Decimal(10, 2)
  status                  String?    @default("ATIVA") @db.VarChar(10)
  lotes                   lotes[]
  empresas                empresas   @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios                usuarios?  @relation(fields: [produtor_responsavel_id], references: [id], onUpdate: NoAction)
  sensores                sensores[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sensores {
  id                 Int                  @id @default(autoincrement())
  codigo_sensor      String               @unique @db.VarChar(50)
  tipo               String               @db.VarChar(50)
  propriedade_id     Int
  lote_id            Int?
  latitude           Decimal?             @db.Decimal(10, 8)
  longitude          Decimal?             @db.Decimal(11, 8)
  data_instalacao    DateTime?            @db.Date
  status             String?              @default("ATIVO") @db.VarChar(15)
  alertas_climaticos alertas_climaticos[]
  leituras_sensores  leituras_sensores[]
  lotes              lotes?               @relation(fields: [lote_id], references: [id], onUpdate: NoAction)
  propriedades       propriedades         @relation(fields: [propriedade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lote_id], map: "idx_sensores_lote")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id           Int            @id @default(autoincrement())
  empresa_id   Int?
  nome         String         @db.VarChar(100)
  cpf          String         @unique @db.VarChar(14)
  email        String         @unique @db.VarChar(100)
  telefone     String?        @db.VarChar(20)
  senha_hash   String         @db.VarChar(255)
  tipo_usuario String?        @db.VarChar(20)
  status       String?        @default("ATIVO") @db.VarChar(10)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  propriedades propriedades[]
  empresas     empresas?      @relation(fields: [empresa_id], references: [id], onUpdate: NoAction)
}
