generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model alertas_climaticos {
  id        Int       @id @default(autoincrement())
  lote_id   Int
  sensor_id Int?
  mensagem  String
  data_hora DateTime? @default(now()) @db.Timestamp(6)
  lido      Boolean?  @default(false)
  lotes     lotes     @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sensores  sensores? @relation(fields: [sensor_id], references: [id], onUpdate: NoAction)
}

model culturas {
  id                      Int              @id @default(autoincrement())
  nome                    String           @db.VarChar(50)
  variedade               String?          @db.VarChar(50)
  temp_recomendada_min    Decimal?         @db.Decimal(5, 2)
  temp_recomendada_max    Decimal?         @db.Decimal(5, 2)
  umidade_recomendada_min Decimal?         @db.Decimal(5, 2)
  umidade_recomendada_max Decimal?         @db.Decimal(5, 2)
  ciclo_medio_dias        Int?
  descricao               String?
  empresa_id              Int?
  temp_base_graus_dia     Decimal?         @db.Decimal(5, 2)
  graus_dia_ciclo         Int?
  ciclos_cultivo          ciclos_cultivo[]
  dados_mercado           dados_mercado[]
  lotes                   lotes[]
  empresas                empresas?        @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresa_id], map: "idx_culturas_empresa")
}

model dados_mercado {
  id               Int      @id @default(autoincrement())
  cultura_id       Int
  mercado_destino  String?  @db.VarChar(100)
  preco_medio      Decimal  @db.Decimal(10, 2)
  moeda            String?  @default("BRL") @db.VarChar(10)
  data_referencia  DateTime @db.Date
  demanda_estimada String?  @db.VarChar(50)
  culturas         culturas @relation(fields: [cultura_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model empresas {
  id           Int            @id @default(autoincrement())
  razao_social String         @db.VarChar(150)
  cpf_cnpj     String         @unique @db.VarChar(20)
  telefone     String?        @db.VarChar(20)
  email        String?        @db.VarChar(100)
  cidade       String?        @db.VarChar(100)
  estado       String?        @db.VarChar(2)
  responsavel  String?        @db.VarChar(100)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  culturas     culturas[]
  propriedades propriedades[]
  usuarios     usuarios[]
}

model informacoes_logisticas {
  id                     Int      @id @default(autoincrement())
  origem                 String   @db.VarChar(100)
  destino                String   @db.VarChar(100)
  modal_transporte       String?  @db.VarChar(50)
  tempo_estimado_horas   Int?
  custo_estimado         Decimal? @db.Decimal(10, 2)
  empresa_transportadora String?  @db.VarChar(100)
  situacao               String?  @db.VarChar(50)
}

model leituras_sensores {
  id           BigInt             @id @default(autoincrement())
  sensor_id    Int
  data_hora    DateTime           @default(now()) @db.Timestamp(6)
  temperatura  Decimal?           @db.Decimal(5, 2)
  umidade      Decimal?           @db.Decimal(5, 2)
  ph           Decimal?           @db.Decimal(6, 2)
  luminosidade Decimal?           @db.Decimal(8, 2)
  precipitacao Decimal?           @db.Decimal(5, 2)
  umidade_solo Decimal?           @db.Decimal(5, 2)
  valores      leituras_valores[]
  sensores     sensores           @relation(fields: [sensor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sensor_id, data_hora], map: "idx_leituras_sensor_data")
}

model lotes {
  id                 Int                  @id @default(autoincrement())
  propriedade_id     Int
  cultura_id         Int
  nome_identificacao String               @db.VarChar(50)
  area_ha            Decimal?             @db.Decimal(10, 2)
  data_plantio       DateTime?            @db.Date
  previsao_colheita  DateTime?            @db.Date
  situacao           String?              @default("EM_CULTIVO") @db.VarChar(20)
  geometria          Json?
  alertas_climaticos alertas_climaticos[]
  ciclos_cultivo     ciclos_cultivo[]
  culturas           culturas             @relation(fields: [cultura_id], references: [id], onUpdate: NoAction)
  propriedades       propriedades         @relation(fields: [propriedade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sensores           sensores[]

  @@index([propriedade_id], map: "idx_lotes_propriedade")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model propriedades {
  id                      Int        @id @default(autoincrement())
  empresa_id              Int
  produtor_responsavel_id Int?
  nome                    String     @db.VarChar(100)
  municipio               String     @db.VarChar(100)
  estado                  String     @db.VarChar(2)
  latitude                Decimal?   @db.Decimal(10, 8)
  longitude               Decimal?   @db.Decimal(11, 8)
  area_total_ha           Decimal?   @db.Decimal(10, 2)
  geometria               Json?
  status                  String?    @default("ATIVA") @db.VarChar(10)
  lotes                   lotes[]
  empresas                empresas   @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios                usuarios?  @relation(fields: [produtor_responsavel_id], references: [id], onUpdate: NoAction)
  sensores                sensores[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sensores {
  id                 Int                  @id @default(autoincrement())
  codigo_sensor      String               @unique @db.VarChar(50)
  tipo               String               @db.VarChar(50)
  propriedade_id     Int
  lote_id            Int?
  latitude           Decimal?             @db.Decimal(10, 8)
  longitude          Decimal?             @db.Decimal(11, 8)
  data_instalacao    DateTime?            @db.Date
  status             String?              @default("ATIVO") @db.VarChar(15)
  alertas_climaticos alertas_climaticos[]
  leituras_sensores  leituras_sensores[]
  medidas            sensor_medidas[]
  lotes              lotes?               @relation(fields: [lote_id], references: [id], onUpdate: NoAction)
  propriedades       propriedades         @relation(fields: [propriedade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lote_id], map: "idx_sensores_lote")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id           Int            @id @default(autoincrement())
  empresa_id   Int?
  nome         String         @db.VarChar(100)
  cpf          String         @unique @db.VarChar(14)
  email        String         @unique @db.VarChar(100)
  telefone     String?        @db.VarChar(20)
  senha_hash   String         @db.VarChar(255)
  tipo_usuario String?        @db.VarChar(20)
  status       String?        @default("ATIVO") @db.VarChar(10)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  propriedades propriedades[]
  empresas     empresas?      @relation(fields: [empresa_id], references: [id], onUpdate: NoAction)
}

/// Dados que cada sensor envia (definidos pelo produtor). chave = campo no JSON do MQTT.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sensor_medidas {
  id        Int                @id @default(autoincrement())
  sensor_id Int
  chave     String             @db.VarChar(40)
  nome      String             @db.VarChar(60)
  unidade   String?            @db.VarChar(20)
  tipo      String             @default("OUTRO") @db.VarChar(20)
  valores   leituras_valores[]
  sensores  sensores           @relation(fields: [sensor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sensor_id, chave], map: "sensor_medidas_sensor_chave_key")
}

/// Valor de cada dado em cada leitura (uma leitura = uma mensagem recebida).
model leituras_valores {
  leitura_id BigInt
  medida_id  Int
  valor      Decimal           @db.Decimal(14, 4)
  leituras   leituras_sensores @relation(fields: [leitura_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medidas    sensor_medidas    @relation(fields: [medida_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([leitura_id, medida_id])
  @@index([medida_id], map: "idx_leituras_valores_medida")
}

/// Histórico de cultivo: cada safra do lote. data_colheita null = em andamento (uma por lote).
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ciclos_cultivo {
  id                Int       @id @default(autoincrement())
  lote_id           Int
  cultura_id        Int
  data_plantio      DateTime? @db.Date
  previsao_colheita DateTime? @db.Date
  data_colheita     DateTime? @db.Date
  producao          Decimal?  @db.Decimal(12, 2)
  unidade_producao  String?   @db.VarChar(20)
  observacoes       String?
  criado_em         DateTime  @default(now()) @db.Timestamp(6)
  culturas          culturas  @relation(fields: [cultura_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lotes             lotes     @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lote_id], map: "idx_ciclos_cultivo_lote")
}

/// Conab PROHORT: comercialização mensal nas Ceasas, por produto, Ceasa e origem.
model precos_atacado {
  id               BigInt  @id @default(autoincrement())
  ano              Int
  mes              Int
  produto          String  @db.VarChar(80)
  ceasa            String  @db.VarChar(120)
  uf_ceasa         String  @db.VarChar(2)
  municipio_origem String  @db.VarChar(120)
  uf_origem        String  @db.VarChar(2)
  quantidade_kg    Decimal @db.Decimal(16, 2)
  valor_rs         Decimal @db.Decimal(16, 2)

  @@index([produto, ano, mes], map: "idx_precos_atacado_produto")
}

/// Conab Preços Agropecuários: preço recebido pelo produtor, por UF e mês.
model precos_produtor {
  id            BigInt  @id @default(autoincrement())
  ano           Int
  mes           Int
  produto       String  @db.VarChar(80)
  classificacao String  @db.VarChar(80)
  uf            String  @db.VarChar(2)
  valor_kg      Decimal @db.Decimal(12, 4)

  @@index([produto, ano, mes], map: "idx_precos_produtor_produto")
}

/// Comex Stat (MDIC): exportações por NCM, país e mês.
model exportacoes {
  id            BigInt  @id @default(autoincrement())
  ano           Int
  mes           Int
  ncm           String  @db.VarChar(8)
  pais          String  @db.VarChar(120)
  valor_fob_usd Decimal @db.Decimal(16, 2)
  peso_kg       Decimal @db.Decimal(16, 2)

  @@index([ncm, ano, mes], map: "idx_exportacoes_ncm")
}

model mercado_importacoes {
  fonte        String    @id @db.VarChar(20)
  iniciado_em  DateTime  @db.Timestamp(6)
  concluido_em DateTime? @db.Timestamp(6)
  linhas       Int?
  erro         String?
}
